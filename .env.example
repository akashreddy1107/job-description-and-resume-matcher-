# Hugging Face Inference API Token
# Get yours at: https://huggingface.co/settings/tokens  (free, Read access is enough)
# Copy this file to .env and fill in your values
HF_TOKEN=your_huggingface_token_here

# Hugging Face model to use for answering questions
# Must be available on the HF Inference Router. Examples:
#   Qwen/Qwen2.5-72B-Instruct  (free tier, recommended)
#   mistralai/Mistral-7B-Instruct-v0.3
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# HF Router API endpoint (leave as default unless you self-host)
HF_API_URL=https://router.huggingface.co/v1/chat/completions

# HR Login Credentials
HR_USERNAME=hr_admin
HR_PASSWORD=your_secure_password_here

# Flask Secret Key (change this to a random string in production)
SECRET_KEY=change-this-super-secret-key-in-production

# Network: default is localhost only. To allow other computers on the same Wi‑Fi/LAN:
#   FLASK_HOST=0.0.0.0
# Then open Windows Firewall for the port (see README or project notes) and browse
#   http://<this-PC-IPv4>:5000  from another machine.
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_DEBUG=true
